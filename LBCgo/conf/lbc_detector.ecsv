# %ECSV 1.0
# ---
# datatype:
# - {name: channel, datatype: string}
# - {name: chip, datatype: int32}
# - {name: gain, unit: electron / adu, datatype: float64}
# - {name: rdnoise, unit: electron, datatype: float64}
# - {name: mjd_start, datatype: float64}
# - {name: mjd_end, datatype: float64}
# - {name: source, datatype: string}
# meta: !!omap
# - comments: ['LBC per-chip detector parameters (gain e-/ADU, read noise e-).', 'Empty by default: GAIN/RDNOISE from the image headers
#       are used until', measured rows are added (see LBCgo.detector.measure_gain_rdnoise_files)., 'channel: LBCB or LBCR. mjd_start inclusive,
#       mjd_end exclusive;', nan means open-ended.]
# schema: astropy-2.0
channel chip gain rdnoise mjd_start mjd_end source
